{
  "name": "@indeks/core",
  "version": "2.0.0",
  "description": "Core browser event tracking library with user behavior analytics",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ru-dr/indeks-sdk.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "check:package": "publint . && attw --pack . --ignore-rules cjs-resolves-to-esm"
  },
  "keywords": [
    "analytics",
    "event-tracking",
    "user-behavior",
    "browser",
    "typescript",
    "fingerprinting"
  ],
  "author": "Indeks contributors",
  "license": "MIT",
  "dependencies": {
    "@indeks/shared": "workspace:*"
  },
  "devDependencies": {
    "@thumbmarkjs/thumbmarkjs": "^1.12.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "peerDependencies": {
    "@thumbmarkjs/thumbmarkjs": "^1.12.0"
  },
  "peerDependenciesMeta": {
    "@thumbmarkjs/thumbmarkjs": {
      "optional": true
    }
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  }
}

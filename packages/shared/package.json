{
  "name": "@indeks/shared",
  "version": "2.0.0",
  "description": "Shared types, constants, and utilities for Indeks SDK",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ru-dr/indeks-sdk.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "check:package": "publint . && attw --pack . --ignore-rules cjs-resolves-to-esm"
  },
  "keywords": [
    "indeks",
    "shared",
    "types",
    "constants",
    "utilities"
  ],
  "author": "Indeks contributors",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}

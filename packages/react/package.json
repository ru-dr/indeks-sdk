{
  "name": "@indeks/react",
  "version": "2.0.0",
  "description": "React hooks and components for Indeks analytics SDK",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./debugger": {
      "import": {
        "types": "./dist/debugger.d.ts",
        "default": "./dist/debugger.js"
      },
      "require": {
        "types": "./dist/debugger.d.cts",
        "default": "./dist/debugger.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ru-dr/indeks-sdk.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "check:package": "publint . && attw --pack . --ignore-rules cjs-resolves-to-esm"
  },
  "keywords": [
    "indeks",
    "react",
    "hooks",
    "analytics",
    "tracking",
    "event-tracking"
  ],
  "author": "Indeks contributors",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "dependencies": {
    "@indeks/core": "workspace:*",
    "@indeks/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "typesVersions": {
    "*": {
      "debugger": [
        "./dist/debugger.d.ts"
      ]
    }
  }
}

{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun", "node"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false
  },
  "include": ["test", "e2e", "examples", "scripts", "playwright.config.ts", "eslint.config.mjs"],
  "exclude": ["**/dist/**", "node_modules"]
}
